# Setup
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

export OP_PLUGIN_ALIASES_SOURCED="1"
gh() {
    op plugin run -- gh "$@"
}

if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Startup
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

alias sudo="sudo-rs"
alias su="su-rs"

. "$HOME/.cargo/env"
