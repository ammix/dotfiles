model_reasoning_effort = "high"
sandbox_mode = "workspace-write"
web_search = "live"

[projects."{{ .chezmoi.homeDir }}/mydots"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/Vault"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/ammix-os"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/Projects"]
trust_level = "trusted"

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
enabled = true

[mcp_servers.context7.env_http_headers]
CONTEXT7_API_KEY = "CONTEXT7_API_KEY"

[mcp_servers.context7.tools.query_docs]
approval_mode = "approve"

[mcp_servers.context7.tools.resolve_library_id]
approval_mode = "approve"
